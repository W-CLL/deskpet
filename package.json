{
  "name": "deskpet-update-center",
  "version": "1.0.0",
  "private": true,
  "description": "Express-based release, activation and update service for DeskPet.",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "migrate": "node scripts/migrate.js",
    "migrate:existing": "node scripts/migrate.js --require-existing",
    "set-password": "node scripts/set-password.js",
    "generate-signing-key": "node scripts/generate-signing-key.js",
    "content:generate": "node scripts/generate-content-library.js",
    "import-release": "node scripts/import-release.js",
    "check": "node scripts/check-js.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}
